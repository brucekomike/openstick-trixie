# Measured from the live device over adb/ssh on 2026-11-05..06 - do not hand-edit from docs.
# source'd by scripts/lib.sh when BOARD_ENV points here. This is the board that has actually
# been reflashed; it now runs Alpine, so the Debian-route fields are historical.
#
#   BOARD_ENV=$PWD/config/board-ufi001c.env BACKUP=$PWD/backup scripts/74-...sh status

BOARD_NAME="Handsome OpenStick UFI001C"
# Since the Alpine image, adb reports the board's own serial (setup_gadget.sh reads it from
# /proc/device-tree/serial-number). Under the vendor Debian image this board answered the
# same placeholder 0123456789 as the UFI103s, which is what made the two indistinguishable.
ADB_SERIAL="<serial-001c>"

BOARD_TAG="UFI001C"
BOARD_SERIALNO="<serial-001c>"                 # also the fastboot serial; pins every `fb` call
BOARD_BACKUP_DIR="backup"

SOC="qcom,msm8916"
DT_COMPATIBLE="handsome,openstick"
ARCH="arm64"
PAGESIZE=4096
RAM_MB=462
EMMC_TOTAL="3.64GiB"

# Storage layout: same GPT shape as the UFI103s (labels and the root PARTUUID match because
# both were laid out by the same tooling), but the partitions are NOT interchangeable -
# see BOARD-ufi001c.md §1 for the four values that differ per unit.
ROOT_DEV="/dev/mmcblk0p14"
ROOT_PARTLABEL="rootfs"
BOOT_DEV="/dev/mmcblk0p12"
BOOT_PARTLABEL="boot"
BOOT_PART_BYTES=$((64*1024*1024))
CALIB_PARTS="modemst1 modemst2 fsg fsc sec cdt devinfo"
FIRMWARE_PARTS="sbl1 rpm tz hyp aboot"

# Vendor kernel, kept on the ext2 boot partition as a labelled fallback (extlinux-5.15.conf).
# The running kernel is the pmOS apk's 6.12.1-msm8916.
KVER="5.15.0-jsbsbxjxh66+"
KIMAGE="/boot/vmlinuz-${KVER}"
KINITRD="/boot/initrd.img-${KVER}"
KERNEL_PKG="linux-image-${KVER}"

BOOT_IMG_BASE="0x80080000"
BOOT_IMG_PAGESIZE=2048

# Boot chain NOW: community lk1st (vendor/openstick-alpine-v0.2/aboot.mbn) + its hyp.mbn,
# booting ext2 + extlinux.conf. sbl1/rpm/tz were left exactly as the factory had them.
# The factory aboot is in backup/part-aboot.bin and has NO extlinux support at all.
BOOT_CHAIN="community lk1st-msm8916 (aboot) + hyp; ext2+extlinux; factory chain in backup/"

ROOT_PARTUUID="a7ab80e8-e9d1-e8cd-f157-93f69b1d141e"
BOOT_CMDLINE="earlycon root=PARTUUID=${ROOT_PARTUUID} console=ttyMSM0,115200 no_framebuffer=true rw rootwait"

# Network: the Alpine image uses configfs NCM (192.168.5.1 with dnsmasq handing the host a
# .20-.60 lease), not the vendor image's RNDIS 10.42.0.1. 30-net-up.sh is a Debian-route
# script and does not apply here - the stick reaches the internet over wlan0 by itself.
STICK_GADGET_IP="192.168.5.1"
STICK_GADGET_NET="192.168.5.0/24"
HOST_GADGET_IF="enx2a85da41ebf9"          # fallback only; detect_gadget_if reads it live
HOST_GADGET_IP="192.168.5.49"
HOST_UPLINK_IF="enp46s0"

# adb provenance. The daemon is the vendor's glibc adbd running under gcompat, plus a
# libcrypto.so.1.1 and a libdl.so.2 symlink - see BOARD-ufi001c.md §4a and
# scripts/76-fetch-adbd-payload.sh. `gc` is gone and was never needed.
ADBD_BIN="/usr/local/sbin/adbd"
GADGET_TOOL=""                            # not used: config/alpine-gadget/setup_gadget.sh is pure configfs
GADGET_SCRIPT="/usr/local/bin/setup_gadget.sh"
