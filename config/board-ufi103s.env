# Measured from the live device over adb on 2026-11-04 - do not hand-edit from docs.
# source'd by scripts/lib.sh

BOARD_NAME="Handsome OpenStick UFI103s"
ADB_SERIAL="0123456789"                 # NOT an identifier: the UFI001C answers this too

# The two values that actually distinguish this stick from the other one in the probe.
# BOARD_SERIALNO is also the fastboot serial, so it is what pins every `fb` call in
# scripts/lib.sh to this unit; BOARD_TAG is matched against the live
# /proc/device-tree/model and against backup/boot-stock.bin's DTB by require_board.
# BOARD_SERIALNO is per-unit and deliberately NOT committed - read it from your own board:
#   adb shell 'grep -o "androidboot.serialno=[0-9a-f]*" /proc/cmdline'
# Empty degrades safely: fastboot runs unpinned and the serial cross-check is skipped.
BOARD_TAG="UFI103s"
BOARD_SERIALNO=""
# Per-unit backup tree. `backup/` belongs to the UFI001C and is not interchangeable:
# pass BACKUP=$PWD/backup-ufi103s to every script run against this stick.
BOARD_BACKUP_DIR="backup-ufi103s"

SOC="qcom,msm8916"                     # Snapdragon 410/410C class, 4x Cortex-A53, ARMv8.0
DT_COMPATIBLE="handsome,openstick"
ARCH="arm64"
PAGESIZE=4096
RAM_MB=461                              # free -m total; 387 available + zram0 230MB swap
EMMC_TOTAL="3.64GiB"

# Storage layout (GPT on /dev/mmcblk0, disk id DB708ACF-2E04-8DE2-BAFE-30C9B26444C5)
ROOT_DEV="/dev/mmcblk0p14"
ROOT_PARTLABEL="rootfs"
BOOT_DEV="/dev/mmcblk0p12"
BOOT_PARTLABEL="boot"
BOOT_PART_BYTES=$((64*1024*1024))
# Partitions that hold calibration / radio identity. NEVER flash these blind.
CALIB_PARTS="modemst1 modemst2 fsg fsc sec cdt devinfo"
# Firmware chain needed to rebuild the boot chain via EDL if ever required.
FIRMWARE_PARTS="sbl1 rpm tz hyp aboot"

# Kernel actually in use (vendor build of an msm8916-mainline style tree)
KVER="5.15.0-jsbsbxjxh66+"
KIMAGE="/boot/vmlinuz-${KVER}"
KINITRD="/boot/initrd.img-${KVER}"
# This kernel is NOT a Debian package: it ships as 5.15.0-jsbsbxjxh66+-10.00.Custom
# and /lib/modules is only 17M. A replacement rootfs MUST carry both.
KERNEL_PKG="linux-image-${KVER}"

# Boot image: Android boot header v0 (no header_version field), page_size 2048,
# kernel ~9.5M with appended DTB, ramdisk ~6.6M, tags_addr 0x81e00000.
BOOT_IMG_BASE="0x80080000"
BOOT_IMG_PAGESIZE=2048

# The boot chain is NOT vendor LK. Read out of backup/part-aboot.bin / part-hyp.bin:
#   aboot: lk2nd_skip, /mnt/lk2nd_rproc_mode, app/aboot/aboot.c, app/aboot/fastboot.c
#   hyp:   qhypstub
# so this stick is already an OpenStick/msm8916-mainline-lineage device and lk2nd's
# extlinux.conf path is available (scripts/66-make-extlinux-boot.sh).
BOOT_CHAIN="lk2nd (aboot) + qhypstub (hyp); fastboot support compiled in"
# The builder's own configs/extlinux.conf carries the SAME root PARTUUID as this device,
# which is what gave the lk2nd lineage away.

# Exact kernel cmdline the stick boots with today (from /proc/cmdline, 2026-11-04).
# Any rebuilt boot.img must keep this, or the new image will not find its rootfs.
ROOT_PARTUUID="a7ab80e8-e9d1-e8cd-f157-93f69b1d141e"
BOOT_CMDLINE="earlycon root=PARTUUID=${ROOT_PARTUUID} console=ttyMSM0,115200 no_framebuffer=true rw androidboot.emmc=true androidboot.serialno=<per-unit> androidboot.baseband=msm mdss_mdp.panel=0:dsi:0:"

# Network: USB gadget rndis only. Stick side is fixed at 10.42.0.1; the HOST side is not -
# the gadget interface is re-created with a new name and a new DHCP lease on every replug
# (enxae1bb47c9ba3/10.42.0.70 on 2026-11-04, enx2e901561235a/10.42.0.30 on 2026-11-06).
# These two are therefore FALLBACKS only: detect_gadget_if in scripts/lib.sh overrides them
# with whatever interface really holds an address in STICK_GADGET_NET right now. Trusting the
# stale value prints sudo lines that NAT the wrong interface and leaves the stick offline.
STICK_GADGET_IP="10.42.0.1"
STICK_GADGET_NET="10.42.0.0/24"
HOST_GADGET_IF="enx2e901561235a"
HOST_GADGET_IP="10.42.0.30"
HOST_UPLINK_IF="enp46s0"

# adb / gadget provenance - the trap this repo works around
ADBD_BIN="/usr/bin/adbd"                # dated 2022, NOT owned by any dpkg package
GADGET_TOOL="gc"                        # gadget-tools; also not a Debian package
GADGET_SCRIPT="/usr/sbin/mobian-usb-gadget"   # calls: gc -c / gc -a rndis / gc -a ffs / gc -e
